<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ site.title }}</title>
<meta name="description" content="{{ site.description }}">
<meta property="og:title" content="{{ site.title }}">
<meta property="og:description" content="{{ site.description }}">
<meta property="og:image" content="{{ site.og_image }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">
</head>
<body>

{% set name_parts = hero.name.split(' ', 1) %}

<header class="site-nav">
  <div class="wrap">
    <img class="brand-logo" src="{{ hero.logo }}" alt="{{ hero.name }}">
    <button class="hamburger-btn" onclick="document.getElementById('menuOverlay').classList.add('open')" aria-label="Buka menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<div class="menu-overlay" id="menuOverlay">
  <div class="menu-overlay-head">
    <img class="brand-logo" src="{{ hero.logo }}" alt="{{ hero.name }}">
    <button class="menu-close-btn" onclick="document.getElementById('menuOverlay').classList.remove('open')" aria-label="Tutup menu">&times;</button>
  </div>
  <div class="menu-list">
    {% for item in nav %}
    <a class="menu-row{% if loop.first %} is-first{% elif loop.last %} is-last{% endif %}" href="{{ item.href }}" onclick="document.getElementById('menuOverlay').classList.remove('open')">
      <span class="menu-row-inner"><span class="num">{{ '%02d'|format(loop.index) }}</span>{{ item.label }}</span>
      <span>&rarr;</span>
    </a>
    {% endfor %}
  </div>
  <div class="menu-overlay-foot">
    <span class="brand">{{ hero.name }}</span>
    <p>{{ hero.eyebrow }}</p>
  </div>
</div>

<section class="hero" id="home">
  <div class="hero-media">
    <img src="{{ hero.photo }}" alt="Foto {{ hero.name }}">
  </div>
  <div class="hero-overlay"></div>
  <div class="hero-content wrap">
    <span class="hero-eyebrow-pill">{{ hero.eyebrow }}</span>
    <h1>{{ name_parts[0] }}{% if name_parts|length > 1 %} <span class="script">{{ name_parts[1] }}</span>{% endif %}</h1>
    <p class="tagline">{{ hero.tagline }}</p>
    <div class="hero-buttons">
      {% for item in nav %}
      <a class="pill-btn {% if loop.first %}solid{% else %}outline{% endif %}" href="{{ item.href }}">
        <span>{{ item.label }}</span><span class="arrow">&rarr;</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<section id="about">
  <div class="wrap about-grid">
    <div class="about-photo-wrap">
      <div class="about-photo">
        <img src="{{ about.photo }}" alt="Foto About {{ hero.name }}">
      </div>
      {% if about.highlights and about.highlights|length > 0 %}
      <div class="about-badge">
        <span class="star">&#9733;</span>
        <strong>{{ about.highlights[0] }}</strong>
        <span>{{ about.highlights[1] if about.highlights|length > 1 else '' }}</span>
      </div>
      {% endif %}
    </div>
    <div class="about-text">
      <p class="eyebrow">Tentang {{ name_parts[0] }}</p>
      <h2>Halo, aku <span class="script">{{ name_parts[0] }}</span>!</h2>
      {% for para in about.body %}
      <p>{{ para }}</p>
      {% endfor %}
      <div class="highlight-row">
        {% for h in about.highlights %}
        <span class="highlight-chip">{{ h }}</span>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<section id="services" class="section-alt">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Layanan & Harga</p>
      <h2>Services & Price List</h2>
    </div>
    <div class="tab-buttons" role="tablist">
      {% for s in services %}
      <button class="tab-btn{% if loop.first %} active{% endif %}" data-tab="{{ s.id }}" role="tab">{{ s.tab_label }}</button>
      {% endfor %}
    </div>
    {% for s in services %}
    {% set tparts = s.title.split(' ', 1) %}
    <div class="tab-panel{% if loop.first %} active{% endif %}" id="panel-{{ s.id }}">
      <div class="service-card">
        <h3>{{ tparts[0] }}{% if tparts|length > 1 %} <span class="italic-serif">{{ tparts[1] }}</span>{% endif %}</h3>
        <p>{{ s.description }}</p>
        {% for pkg in s.packages %}
        {% set pkg_msg = 'Halo kak Ovha, saya mau tanya harga untuk paket ' ~ pkg.name ~ ' (' ~ s.title ~ ').' %}
        <div class="package-row">
          <span class="pkg-name">{{ pkg.name }}</span>
          <a class="pkg-price-btn" href="https://wa.me/{{ booking.whatsapp_number }}?text={{ pkg_msg | urlencode }}" target="_blank" rel="noopener">Tanya Harga &rarr;</a>
        </div>
        {% endfor %}
        <a class="cta-link" href="#booking">Book {{ s.tab_label }}</a>
      </div>
    </div>
    {% endfor %}
  </div>
</section>

<section id="tutorial">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">YouTube</p>
      <h2>{{ youtube.heading }}</h2>
      <p>{{ youtube.subheading }}</p>
    </div>
    <div class="video-grid">
      {% for v in youtube.videos %}
      <div class="video-frame">
        <iframe src="{{ v.embed_url }}" title="{{ v.title }}" allowfullscreen loading="lazy"></iframe>
      </div>
      {% endfor %}
    </div>
    <div style="text-align:center; margin-top:28px;">
      <a class="cta-link" href="{{ youtube.channel_url }}" target="_blank" rel="noopener">Subscribe di YouTube</a>
    </div>
  </div>
</section>

<section id="racun" class="section-alt">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Rekomendasi</p>
      <h2>{{ products.heading }}</h2>
      <p>{{ products.subheading }}</p>
    </div>
    <div class="product-grid">
      {% for p in products.list %}
      <div class="product-card">
        <span class="p-name">{{ p.name }}</span>
        <a class="p-link" href="{{ p.url }}" target="_blank" rel="noopener">Cek Produk &rarr;</a>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section id="testimoni">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Testimoni</p>
      <h2>{{ testimonials.heading }}</h2>
    </div>
    <div class="testi-grid">
      {% for t in testimonials.list %}
      <div class="testi-card">
        <div class="testi-stars">{{ '★' * t.rating }}</div>
        <p class="testi-quote">&ldquo;{{ t.quote }}&rdquo;</p>
        <div class="testi-name">{{ t.name }}</div>
        <div class="testi-cat">{{ t.category }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section id="booking">
  <div class="wrap">
    {% set bparts = booking.heading.split(' ', 1) %}
    <div class="booking-box">
      <p class="eyebrow">Luxury Booking</p>
      <h2><span class="script">{{ bparts[0] }}</span>{% if bparts|length > 1 %} {{ bparts[1] }}{% endif %}</h2>
      <p>{{ booking.subheading }}</p>
      <a class="booking-cta" href="https://wa.me/{{ booking.whatsapp_number }}?text={{ booking.whatsapp_message | urlencode }}" target="_blank" rel="noopener">Chat via WhatsApp</a>
    </div>
  </div>
</section>

<footer>
  <div class="wrap">
    <div class="footer-socials">
      {% for s in socials %}
      <a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.platform }} &middot; {{ s.handle }}</a>
      {% endfor %}
    </div>
    <p class="fine-print">{{ footer.note }}</p>
  </div>
</footer>

<script>
document.querySelectorAll('.tab-btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    document.querySelectorAll('.tab-btn').forEach(function(b){ b.classList.remove('active'); });
    document.querySelectorAll('.tab-panel').forEach(function(p){ p.classList.remove('active'); });
    btn.classList.add('active');
    document.getElementById('panel-' + btn.dataset.tab).classList.add('active');
  });
});
</script>

</body>
</html>
